{
  "crons": [
    {
      "path": "/api/sports/sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/sports/sync-transfers",
      "schedule": "25 */6 * * *"
    },
    {
      "path": "/api/notifications/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/news/cron",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/youtube/cron",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/system/backup?kind=daily",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/system/backup?kind=weekly",
      "schedule": "0 0 * * 0"
    }
  ]
}
